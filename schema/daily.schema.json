{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily nuclear news briefing",
  "type": "object",
  "required": ["date", "generated_at", "period", "overview_ko", "countries_pulse", "articles"],
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at": { "type": "string", "description": "ISO 8601 with offset" },
    "period": {
      "type": "object",
      "required": ["from", "to"],
      "properties": { "from": { "type": "string" }, "to": { "type": "string" } }
    },
    "overview_ko": { "type": "string", "description": "해외 요약" },
    "overview_en": { "type": "string", "description": "해외 요약 (영어)" },
    "domestic_overview_ko": { "type": "string", "description": "국내 요약" },
    "domestic_overview_en": { "type": "string", "description": "국내 요약 (영어)" },
    "countries_pulse": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["country", "name_ko", "stance", "signal", "article_ids"],
        "properties": {
          "country": { "type": "string", "description": "ISO alpha-2 or INT" },
          "name_ko": { "type": "string" },
          "name_en": { "type": "string" },
          "stance": { "enum": ["expanding", "steady", "cautious", "retreating"] },
          "signal": { "type": "string" },
          "signal_en": { "type": "string" },
          "article_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "title_ko", "source", "url", "published", "category", "countries", "importance", "summary_ko", "sales_note"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "title_ko": { "type": "string" },
          "language": { "type": "string", "description": "ISO 639-1 language of the original article (en, cs, ja, ...)" },
          "source": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "published": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "region": { "enum": ["overseas", "domestic"], "description": "없으면 overseas로 간주" },
          "category": { "enum": ["large", "smr", "policy", "fuel"] },
          "countries": { "type": "array", "items": { "type": "string" } },
          "importance": { "enum": [1, 2, 3] },
          "summary_ko": { "type": "string" },
          "title_en": { "type": "string" },
          "summary_en": { "type": "string" },
          "sales_note_en": { "type": "string" },
          "sales_note": { "type": "string" },
          "related": { "type": "array", "items": { "type": "string", "format": "uri" } }
        }
      }
    }
  }
}
